# ========================================
# SENSITIVE FILES - NEVER COMMIT THESE!
# ========================================

# Environment variables (API keys, passwords, etc.)
.env
.env.local
.env.production
.env.development

# Google Service Account Credentials
credentials.json
service-account.json
google-credentials.json
*-credentials.json

# SSL Certificates
*.pem
*.key
*.crt
*.p12

# ========================================
# NODE.JS / NPM
# ========================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ========================================
# UPLOADS & TEMPORARY FILES
# ========================================

# User uploaded files
uploads/
*.mp4
*.mov
*.avi
*.mkv
*.pdf
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Temporary files
temp/
tmp/
*.tmp
*.temp
*.log

# ========================================
# DATABASES & LOGS
# ========================================

# JSON databases
*-database.json
*-cache.json
*-tracking.json
learning-database.json
speed-limit-cache.json
api-usage-tracking.json

# Log files
logs/
*.log
performance.log
error.log
access.log

# ========================================
# IDE / EDITOR FILES
# ========================================

# VSCode
.vscode/
*.code-workspace

# WebStorm / IntelliJ
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ========================================
# OPERATING SYSTEM FILES
# ========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ========================================
# BUILD / DEPLOYMENT
# ========================================

# Build output
dist/
build/
out/

# PM2
.pm2/
ecosystem.config.js

# ========================================
# BACKUP FILES
# ========================================

# Backup files
*.backup
*.bak
*.old
*-backup.*
*-old.*

# ========================================
# ALLOW SPECIFIC FILES (override above)
# ========================================

# Example: Allow sample/template env file
!.env.example
!.env.template
